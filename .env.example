# Copy to .env and fill in. dbt Fusion loads .env from the project directory automatically.
# 12-digit AWS account ID that owns the Glue Data Catalog (the Iceberg REST "warehouse")
export GLUE_ACCOUNT_ID=123456789012
# S3 prefix for table data; each table is written to <root>/<table_name>
export ICEBERG_LOCATION_ROOT=s3://your-bucket/your_database.db
# Glue database (Iceberg namespace) models are written to; must already exist
export GLUE_DATABASE=your_database
